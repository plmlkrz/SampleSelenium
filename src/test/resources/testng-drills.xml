<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Sequential TestNG drill suite.
  Run:  mvn test -Ptestng-drills -Dheadless=true

  Interview note: a <suite> contains <test> tags, each <test> contains <classes>.
  @BeforeSuite runs once for this whole file; @BeforeTest runs once per <test> tag —
  that distinction (Infosys TestNG Q3) is visible in the console output of this run.

  Run only one group:  mvn test -Ptestng-drills -Dheadless=true -Dgroups=smoke
-->
<suite name="TestNG Drill Suite" verbose="1">
    <test name="TestNG Core Drills">
        <classes>
            <class name="com.sampleselenium.drills.d03_testng.SourceD03TestNgDrills"/>
            <class name="com.sampleselenium.drills.d03_testng.PracticeD03TestNgDrills"/>
        </classes>
    </test>
    <test name="Parallel Drills Run Serially For Comparison">
        <classes>
            <class name="com.sampleselenium.drills.d04_parallel.SourceD04ParallelDrills"/>
            <class name="com.sampleselenium.drills.d04_parallel.PracticeD04ParallelDrills"/>
        </classes>
    </test>
</suite>
